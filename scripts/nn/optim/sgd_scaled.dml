/*
 * Scaled Gradient Descent (ScaledGD) optimizer.
 */

update = function(matrix[double] L, matrix[double] R matrix[double] dL,
                matrix[double] dR, double lr)
    return (matrix[double] L, matrix[double] R) {

    # Step 1: Compute scaling matrices (preconditioners)
    R_inv = inv(t(R) %*% R)     # (r x r) inverse of Rᵀ * R
    L_inv = inv(t(L) %*% L)     # (r x r) inverse of Lᵀ * L

    # Step 2: Update L with scaled gradient descent
    L = L - lr %*% (dL %*% R_inv)    # Scale gradient for L by (Rᵀ * R)⁻¹

    # Step 3: Update R with scaled gradient descent
    R = R - lr %*% (dR %*% L_inv)

}
